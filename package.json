{
  "name": "brc",
  "displayName": "Bits Runner Code",
  "description": "BRC language support for VSCode",
  "version": "0.7.0",
  "publisher": "rafalgrodzinski",
  "author": {
        "name": "Rafal Grodzinski"
  },
  "icon": "./img/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafalgrodzinski/brc-vscode"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "brc",
      "aliases": ["Bits Runner Code", "brc"],
      "extensions": [".brc"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./img/icon.png",
        "dark": "./img/icon.png"
      }
    }],
    "grammars": [{
      "language": "brc",
      "scopeName": "source.brc",
      "path": "./syntaxes/brc.tmLanguage.json"
    }],
    "problemMatchers": [{
      "name": "brc",
      "owner": "brc",
      "fileLocation": "autoDetect",
      "pattern": {
          "regexp": "^(🔥|⛔️).+file\\s+([^,]+).+line\\s+(\\d+).+column\\s+(\\d+):\\s*(.+)$",
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 5
      }
    }]
  },
  "activationEvents": [],
  "main": "./src/extension.js"
}
